{
	"name": "admin-color-schemes",
	"slug": "admin-color-schemes",
	"description": "WordPress dashboard color schemes",
	"version": "4.0.0",
	"dependencies": {
		"@wordpress/hooks": "^4.51.0",
		"autoprefixer": "^10.5.0",
		"execa": "^10.0.0",
		"sass": "^1.98.0",
		"stylelint": "^16.8.2"
	},
	"devDependencies": {
		"@wordpress/env": "11.11.0",
		"@wordpress/scripts": "^33.0.0",
		"@wordpress/stylelint-config": "24.0.0"
	},
	"stylelint": {
		"extends": [
			"@wordpress/stylelint-config/scss"
		],
		"rules": {
			"no-descending-specificity": null
		},
		"ignoreFiles": [
			"_*.scss",
			"editor.css"
		]
	},
	"scripts": {
		"wp-env": "wp-env",
		"start": "node ./bin/build.mjs",
		"prebuild": "wp-scripts build scripts/editor-color-scheme.ts",
		"build": "node ./bin/build.mjs",
		"lint:js": "wp-scripts lint-js scripts",
		"lint:style": "stylelint src/**/*.scss"
	}
}
