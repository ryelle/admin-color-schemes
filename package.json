{
	"name": "admin-color-schemes",
	"slug": "admin-color-schemes",
	"description": "WordPress dashboard color schemes",
	"version": "3.0.0",
	"dependencies": {
		"autoprefixer": "^10.5.0",
		"execa": "^9.6.1",
		"sass": "^1.98.0",
		"stylelint": "^16.8.2"
	},
	"devDependencies": {
		"@wordpress/env": "11.5.0",
		"@wordpress/stylelint-config": "23.37.0"
	},
	"stylelint": {
		"extends": [
			"@wordpress/stylelint-config/scss"
		],
		"rules": {
			"no-descending-specificity": null
		},
		"ignoreFiles": [
			"_*.scss",
			"editor.css"
		]
	},
	"scripts": {
		"wp-env": "wp-env",
		"start": "node ./scripts/build.mjs",
		"build": "node ./scripts/build.mjs",
		"lint": "stylelint */*.scss"
	}
}
